# Required: Your TrekMail instance URL
TREKMAIL_BASE_URL=https://your-trekmail-instance.com

# At least one of these tokens is required:

# API token for infrastructure tools (domains, mailboxes, invites, forwarding, delete)
# TREKMAIL_API_TOKEN=tm_live_your_token_here

# Message token for mailbox message tools (list, read, send)
# TREKMAIL_MESSAGE_TOKEN=tm_msg_your_message_token_here

# Optional: Request timeout in milliseconds (default: 30000)
# TREKMAIL_TIMEOUT_MS=30000

# Optional: Custom User-Agent header (default: trekmail-mcp/1.6.0)
# TREKMAIL_USER_AGENT=trekmail-mcp/1.6.0

# Optional: Allow destructive operations like confirm_delete_intent (default: false)
# TREKMAIL_ALLOW_DESTRUCTIVE=false

# Optional: Allow sending emails via send_message tool (default: false)
# TREKMAIL_ALLOW_SENDING=false

# Optional: Allow migration operations — start, cancel, retry, delete (default: false)
# TREKMAIL_ALLOW_MIGRATION=false
